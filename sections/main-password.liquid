<div class="password-page plate--pine">
  <header class="password-page__head">
    <span class="password-page__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, width: 200, height: nil }}
      {%- elsif settings.logo == blank -%}
        <img src="{{ 'logo.png' | asset_img_url: '480x' }}" width="238" height="40" alt="{{ shop.name | escape }}">
      {%- else -%}
        <span class="br-display" style="font-size:1.4rem">{{ shop.name }}</span>
      {%- endif -%}
    </span>
    <details>
      <summary>{{ 'general.password_page.login_form_heading' | t }}</summary>
      <div class="password-page__panel">
        {%- form 'storefront_password', class: 'password-page__form' -%}
          {%- if form.errors -%}<p class="form__message form__message--error" role="alert">{% render 'icon', icon: 'error' %} {{ form.errors.messages.form }}</p>{%- endif -%}
          <div class="field">
            <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
            <input class="field__input" id="Password" type="password" name="password" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" style="background:transparent;color:inherit;border-color:currentColor">
          </div>
          <button type="submit" class="btn btn--paper">{{ 'general.password_page.login_form_submit' | t }}</button>
        {%- endform -%}
      </div>
    </details>
  </header>

  <main class="password-page__main">
    <p class="br-rule">{{ shop.name }}</p>
    <h1 class="br-display password-page__title">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="br-lede">{{ shop.password_message }}</p>{%- endif -%}
    {%- if section.settings.show_newsletter -%}
      {%- form 'customer', class: 'password-page__form', id: 'PasswordNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success" role="status">{% render 'icon', icon: 'check' %} {{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="field">
            <label class="visually-hidden" for="PasswordEmail">{{ 'newsletter.label' | t }}</label>
            <input class="field__input" id="PasswordEmail" type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required style="background:transparent;color:inherit;border-color:currentColor">
          </div>
          <button type="submit" class="btn btn--accent">{{ 'newsletter.button' | t }}</button>
          {%- if form.errors -%}<p class="form__message form__message--error" role="alert">{% render 'icon', icon: 'error' %} {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}
  </main>

  <footer class="password-page__foot">
    <span>{{ powered_by_link }}</span>
    <span>{{ 'general.password_page.admin_link_html' | t }}</span>
  </footer>
</div>

{% schema %}
{
  "class": "paper",
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true }
  ]
}
{% endschema %}

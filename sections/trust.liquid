{%- comment -%}
  Split: photo with the offset red block, copy with a checklist, and an optional row of
  counters over a rule. Home (trust) and the location page (services checklist).
{%- endcomment -%}
{%- liquid
  assign ticks = section.blocks | where: 'type', 'tick'
  assign stats = section.blocks | where: 'type', 'stat'
  assign ig = shop.metafields.custom.instagram_followers.value | default: settings.instagram_followers
-%}
<section class="sc-section paper{% if section.settings.ground == 'paper-2' %} paper--2{% endif %}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap split">
    <figure class="shot shot--block slide" data-dir="left">
      {%- render 'photo', image: section.settings.image, bundled: section.settings.bundled, alt: section.settings.image_alt, sizes: '(max-width: 860px) 92vw, 42vw' -%}
    </figure>
    <div class="split__copy" data-sc-in data-sc-stagger="70">
      {%- if section.settings.tag != blank -%}<p class="tag tag--red">{{ section.settings.tag | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="sc-display sc-display--md">{% render 'heading-hl', text: section.settings.heading, hl: section.settings.highlight %}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="sc-body">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if ticks.size > 0 -%}
        <ul class="ticks">
          {%- for block in ticks -%}
            <li {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{% else %}{{ block.settings.text | escape }}{% endif %}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <p><a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a></p>
      {%- endif -%}
    </div>
  </div>
  {%- if stats.size > 0 -%}
    <div class="sc-wrap">
      <dl class="stats" data-sc-in data-sc-stagger="80">
        {%- for block in stats -%}
          {%- liquid
            assign value = block.settings.value
            if block.settings.source == 'instagram_followers'
              assign value = ig
            endif
          -%}
          <div {{ block.shopify_attributes }}><dt><span data-sc-count="0 {{ value | escape }}" data-sc-count-at="0.02 0.12">{{ value | escape }}</span></dt><dd>{{ block.settings.label | escape }}</dd></div>
        {%- endfor -%}
      </dl>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Photo and checklist",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Empty: the bundled photo picked below." },
    { "type": "select", "id": "bundled", "label": "Bundled photo", "options": [{"value": "none", "label": "None"}, {"value": "hero", "label": "Vans at the Lafayette shop"}, {"value": "trust", "label": "Technicians lifting a windshield"}, {"value": "svc-windshield", "label": "Windshield going on a Ford"}, {"value": "svc-chip", "label": "Star chip close up"}, {"value": "svc-back", "label": "Tesla, back glass out"}, {"value": "svc-adas", "label": "ADAS targets"}, {"value": "svc-door", "label": "Shattered door glass"}, {"value": "svc-fleet", "label": "Sprinter van in the shop"}, {"value": "svc-mobile", "label": "Black van outside the shop"}, {"value": "bleed-insurance", "label": "Windshield on a red SUV"}, {"value": "story", "label": "Fleet outside the storefront"}, {"value": "loc-lafayette", "label": "Lafayette shop front"}, {"value": "loc-kenner", "label": "Kenner shop entrance"}, {"value": "loc-nola-van", "label": "New Orleans van"}, {"value": "ba-before", "label": "Jeep, glass out"}, {"value": "ba-after", "label": "Jeep, glass in"}], "default": "trust" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "info": "Empty: the photo's own description." },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Your trusted auto glass experts" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We fix all types of auto glass." },
    { "type": "text", "id": "highlight", "label": "Words on the red bar", "info": "Must match words in the heading exactly.", "default": "all types" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our company specializes in providing professional auto glass services for a wide range of vehicle types, including both personal and commercial vehicles." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "text", "id": "link", "label": "Link" },
    { "type": "select", "id": "ground", "label": "Ground", "options": [{ "value": "paper", "label": "White" }, { "value": "paper-2", "label": "Off-white" }], "default": "paper" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id" }
  ],
  "blocks": [
    { "type": "tick", "name": "Checklist item", "limit": 8, "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Insurance policies accepted" },
      { "type": "text", "id": "link", "label": "Link", "info": "Optional." }
    ] },
    { "type": "stat", "name": "Counter", "limit": 4, "settings": [
      { "type": "text", "id": "value", "label": "Number", "default": "4.8" },
      { "type": "text", "id": "label", "label": "Label", "default": "Google rating, Lafayette" },
      { "type": "select", "id": "source", "label": "Number comes from", "options": [{ "value": "manual", "label": "The number above" }, { "value": "instagram_followers", "label": "Instagram followers (Theme settings > Social media)" }], "default": "manual" }
    ] }
  ],
  "presets": [{ "name": "Photo and checklist", "blocks": [{ "type": "tick" }, { "type": "tick", "settings": { "text": "Cars, SUVs and trucks" } }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

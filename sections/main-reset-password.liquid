<div class="page-width auth">
  <div class="u-stack">
    <p class="br-rule">{{ 'customer.account.caption' | t }}</p>
    <h1 class="br-display auth__title">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="br-body">{{ 'customer.reset_password.subtext' | t }}</p>
  </div>
  {%- form 'reset_customer_password', class: 'form-stack' -%}
    {%- if form.errors -%}
      <div class="form__message form__message--error form__errors" role="alert" tabindex="-1" autofocus>{% render 'icon', icon: 'error' %}<div>{{ 'contact.form.error_heading' | t }}<ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul></div></div>
    {%- endif -%}
    <div class="field"><label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label><input class="field__input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label><input class="field__input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <div><button type="submit" class="btn">{{ 'customer.reset_password.submit' | t }}</button></div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "settings": []
}
{% endschema %}

{%- comment -%} Claim steps beside a sticky full-height photo, then the Enterprise and student program cards. {%- endcomment -%}
{%- liquid
  assign offer = section.settings.student_offer_1 | append: '\A ' | append: section.settings.student_offer_2 | remove: "'" | remove: '"' | remove: ';' | remove: '<' | remove: '>'
  capture sms_href
    render 'phone', phone: settings.phone_lafayette, as: 'sms'
  endcapture
  capture van
    render 'phone', phone: settings.phone_lafayette, as: 'van'
  endcapture
  assign van = van | strip
-%}
<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} class="ins paper paper--2" data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="bleed">
    <div class="bleed__copy">
      <div data-sc-in data-sc-stagger="70">
        {%- if section.settings.tag != blank -%}<p class="tag tag--red">{{ section.settings.tag | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="sc-display sc-display--md">{% render 'heading-hl', text: section.settings.heading, hl: section.settings.highlight, break_before: true %}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="sc-body">{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ol class="steps" data-sc-in data-sc-stagger="90">
          {%- for block in section.blocks -%}
            <li class="step" data-type-only {{ block.shopify_attributes }}><span class="step__n">{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}</li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      <div class="bleed__actions" data-sc-in data-sc-stagger="70">
        {%- render 'action-link', action: section.settings.btn_1_action, label: section.settings.btn_1_label, url: section.settings.btn_1_link, class: 'btn btn--accent' -%}
        {%- render 'action-link', action: section.settings.btn_2_action, label: section.settings.btn_2_label, url: section.settings.btn_2_link, class: 'btn btn--line' -%}
      </div>
    </div>
    <figure class="bleed__photo slide" data-dir="right">
      {%- render 'photo', image: section.settings.image, bundled: 'bleed-insurance', alt: section.settings.image_alt, sizes: '(max-width: 860px) 100vw, 50vw' -%}
    </figure>
  </div>
  {%- if section.settings.show_enterprise or section.settings.show_student -%}
    <div class="sc-wrap programs" data-sc-in data-sc-stagger="90">
      {%- if section.settings.show_enterprise -%}
        <div class="program" data-type-only>
          {%- if section.settings.ent_tag != blank -%}<p class="tag tag--red">{{ section.settings.ent_tag | escape }}</p>{%- endif -%}
          {%- if section.settings.ent_heading != blank -%}<h3>{{ section.settings.ent_heading | escape }}</h3>{%- endif -%}
          {%- if section.settings.ent_text != blank -%}<p>{{ section.settings.ent_text | escape }}</p>{%- endif -%}
          <ul class="program__links">
            {%- if settings.phone_lafayette != blank -%}<li><a href="{{ sms_href | strip }}">{{ 'general.text_number' | t: phone: van }}</a></li>{%- endif -%}
            {%- if settings.enterprise_email != blank -%}<li><a href="mailto:{{ settings.enterprise_email }}">{{ 'general.email_address' | t: email: settings.enterprise_email }}</a></li>{%- endif -%}
            {%- if settings.enterprise_form_url != blank and section.settings.ent_form_label != blank -%}<li><a href="{{ settings.enterprise_form_url }}" target="_blank" rel="noopener">{{ section.settings.ent_form_label | escape }}</a></li>{%- endif -%}
            {%- if settings.enterprise_photo_url != blank and section.settings.ent_photo_label != blank -%}<li><a href="{{ settings.enterprise_photo_url }}" target="_blank" rel="noopener">{{ section.settings.ent_photo_label | escape }}</a></li>{%- endif -%}
            {%- if section.settings.ent_page_label != blank and section.settings.ent_page_link != blank -%}<li><a href="{{ section.settings.ent_page_link }}">{{ section.settings.ent_page_label | escape }}</a></li>{%- endif -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.show_student -%}
        {%- capture student_attrs -%}style="--offer: '{{ offer | escape }}'"{%- endcapture -%}
        {%- render 'student-card', tag: section.settings.student_tag, heading: section.settings.student_heading, text: section.settings.student_text, schools: section.settings.student_schools, link_1_label: section.settings.student_btn_label, link_1_action: section.settings.student_btn_action, link_1_link: section.settings.student_btn_link, link_2_label: section.settings.student_page_label, link_2_link: section.settings.student_page_link, attrs: student_attrs -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Insurance",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "Insurance policy claims" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "File the claim. We handle the rest." },
    { "type": "text", "id": "highlight", "label": "Words on the red bar", "info": "Starts on its own line. Must match words in the heading exactly.", "default": "We handle the rest." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We work with all insurance providers. Call your insurance and use the company name Geaux Auto Glass to begin the filing." },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait works best. It holds in place while the steps scroll. Empty: the bundled photo." },
    { "type": "text", "id": "image_alt", "label": "Photo description", "info": "Empty: the photo's own description." },
    { "type": "text", "id": "btn_1_label", "label": "First button label", "default": "Get a quote" },
    { "type": "select", "id": "btn_1_action", "label": "First button goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "quote" },
    { "type": "text", "id": "btn_1_link", "label": "First button custom link" },
    { "type": "text", "id": "btn_2_label", "label": "Second button label", "info": "Empty on a call button: Call and the number." },
    { "type": "select", "id": "btn_2_action", "label": "Second button goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "call_lafayette" },
    { "type": "text", "id": "btn_2_link", "label": "Second button custom link" },
    { "type": "header", "content": "Enterprise card" },
    { "type": "paragraph", "content": "The text number, the email and both form links come from Theme settings > Business." },
    { "type": "checkbox", "id": "show_enterprise", "label": "Show the Enterprise card", "default": true },
    { "type": "text", "id": "ent_tag", "label": "Tag", "default": "Enterprise claim submission" },
    { "type": "text", "id": "ent_heading", "label": "Heading", "default": "Approved vendor for Enterprise Rent-A-Car." },
    { "type": "textarea", "id": "ent_text", "label": "Text", "default": "Submit your claim quickly and our team handles the rest. Fast, friendly service." },
    { "type": "text", "id": "ent_form_label", "label": "Claim form link label", "default": "Fill out the claim form" },
    { "type": "text", "id": "ent_photo_label", "label": "Photo upload link label", "default": "Upload a photo of the claim page" },
    { "type": "text", "id": "ent_page_label", "label": "Page link label", "default": "Enterprise claims page" },
    { "type": "text", "id": "ent_page_link", "label": "Page link", "default": "/pages/enterprise-claims" },
    { "type": "header", "content": "Student card" },
    { "type": "checkbox", "id": "show_student", "label": "Show the student card", "default": true },
    { "type": "text", "id": "student_tag", "label": "Tag", "default": "Student discount" },
    { "type": "text", "id": "student_heading", "label": "Heading", "default": "10% off all services for college students." },
    { "type": "textarea", "id": "student_text", "label": "Text", "default": "For students at University of Louisiana at Lafayette or South Louisiana Community College. All car, SUV and truck glass." },
    { "type": "text", "id": "student_schools", "label": "School chips", "info": "Separate with commas. Names only, no logos.", "default": "UL Lafayette, SLCC" },
    { "type": "text", "id": "student_offer_1", "label": "Round patch, line 1", "default": "10%" },
    { "type": "text", "id": "student_offer_2", "label": "Round patch, line 2", "default": "OFF" },
    { "type": "text", "id": "student_btn_label", "label": "First link label", "default": "Get a quote" },
    { "type": "select", "id": "student_btn_action", "label": "First link goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "quote" },
    { "type": "text", "id": "student_btn_link", "label": "First link custom link" },
    { "type": "text", "id": "student_page_label", "label": "Page link label", "default": "Student discount page" },
    { "type": "text", "id": "student_page_link", "label": "Page link", "default": "/pages/student-discount" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "insurance" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Insurance" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

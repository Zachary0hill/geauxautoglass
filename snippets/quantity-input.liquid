{%- comment -%} Params: id, name, value, min, max, label, form {%- endcomment -%}
<div class="quantity">
  <button type="button" class="quantity__button" data-dir="down" aria-label="{{ 'products.product.quantity.decrease' | t: product: label | escape }}">{% render 'icon', icon: 'minus' %}</button>
  <input class="quantity__input" type="number" id="{{ id }}" name="{{ name | default: 'quantity' }}" value="{{ value | default: 1 }}" min="{{ min | default: 1 }}"{% if max %} max="{{ max }}"{% endif %} step="1" inputmode="numeric" aria-label="{{ 'products.product.quantity.label' | t }}"{% if form %} form="{{ form }}"{% endif %}{% if data_index %} data-index="{{ data_index }}"{% endif %}>
  <button type="button" class="quantity__button" data-dir="up" aria-label="{{ 'products.product.quantity.increase' | t: product: label | escape }}">{% render 'icon', icon: 'plus' %}</button>
</div>

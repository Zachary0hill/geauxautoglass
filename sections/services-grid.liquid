{%- comment -%} Six service cards plus the full-width "We come to you" band. The grid is built for six cards.
  On the services page it runs on the white ground with no heading block and no band, and each card carries an id so links can land on it. {%- endcomment -%}
{%- assign cities = section.settings.band_cities | split: ',' -%}
<section{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} class="sc-section svc{% if section.settings.ground == 'paper' or section.settings.ground == 'paper-2' %} paper{% if section.settings.ground == 'paper-2' %} paper--2{% endif %}{% endif %}{% if section.settings.show_band == false %} svc--plain{% endif %}" data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap">
    {%- if section.settings.show_head != false -%}
    <div class="svc__head">
      <div data-sc-in data-sc-stagger="70">
        {%- if section.settings.tag != blank -%}<p class="tag tag--red">{{ section.settings.tag | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="sc-display sc-display--md">{% render 'heading-hl', text: section.settings.heading, hl: section.settings.highlight %}</h2>{%- endif -%}
      </div>
      <div class="svc__lead" data-sc-in data-sc-stagger="70">
        {%- if section.settings.text != blank -%}<p class="sc-body">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- render 'action-link', action: section.settings.btn_action, label: section.settings.btn_label, url: section.settings.btn_link, class: 'btn btn--accent' -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}<a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="svc__grid">
        {%- for block in section.blocks -%}
          <article class="card"{% if block.settings.anchor_id != blank %} id="{{ block.settings.anchor_id | handle }}"{% endif %} data-sc-in {{ block.shopify_attributes }}>
            <div class="card__fig slide" data-dir="{{ block.settings.dir }}" data-sc-tilt="4">{% render 'photo', image: block.settings.image, bundled: block.settings.bundled, alt: block.settings.image_alt, sizes: '(max-width: 860px) 46vw, 28vw' %}</div>
            <p class="card__n">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p>
            <h3>{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{%- else -%}{{ block.settings.title | escape }}{%- endif -%}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_band -%}
    <div class="svc__band slide" data-dir="band">
      <div class="svc__band-photo">
        <div class="svc__band-clip">{% render 'photo', image: section.settings.band_image, bundled: 'svc-mobile', alt: section.settings.band_image_alt, sizes: '(max-width: 860px) 100vw, 50vw' %}</div>
      </div>
      <div class="sc-wrap svc__band-in">
        <div class="svc__band-copy">
          {%- if section.settings.band_tag != blank -%}<p class="tag tag--red">{{ section.settings.band_tag | escape }}</p>{%- endif -%}
          {%- if section.settings.band_heading != blank -%}<h3 class="sc-display svc__band-h">{% render 'heading-hl', text: section.settings.band_heading, hl: section.settings.band_highlight %}</h3>{%- endif -%}
          {%- if section.settings.band_text != blank -%}<p class="svc__band-lede">{{ section.settings.band_text | escape }}</p>{%- endif -%}
          {%- if cities.size > 0 -%}
            <ul class="svc__band-cities" aria-label="{{ section.settings.band_cities_label | escape }}">
              {%- for city in cities -%}{%- assign name = city | strip -%}{%- if name != blank -%}<li>{{ name | escape }}</li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="svc__band-actions">
            {%- render 'action-link', action: section.settings.band_btn_1_action, label: section.settings.band_btn_1_label, url: section.settings.band_btn_1_link, class: 'btn btn--accent' -%}
            {%- render 'action-link', action: section.settings.band_btn_2_action, label: section.settings.band_btn_2_label, url: section.settings.band_btn_2_link, class: 'btn btn--ghost' -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Services grid",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "ground", "label": "Ground", "options": [{ "value": "dark", "label": "Dark" }, { "value": "paper", "label": "White" }, { "value": "paper-2", "label": "Off-white" }], "default": "dark" },
    { "type": "checkbox", "id": "show_head", "label": "Show the heading block", "info": "Tag, heading, text, button and link. Turn off under a page head that already says it.", "default": true },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Services" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Repairs and replacements." },
    { "type": "text", "id": "highlight", "label": "Words on the red bar", "info": "Optional. Must match words in the heading exactly." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Free mobile service. Fast and affordable. Same day or next day." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Get a quote" },
    { "type": "select", "id": "btn_action", "label": "Button goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "quote" },
    { "type": "text", "id": "btn_link", "label": "Button custom link" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All services" },
    { "type": "text", "id": "link", "label": "Link", "default": "/pages/services" },
    { "type": "paragraph", "content": "Keep the grid at six cards. An odd count leaves a lone card." },
    { "type": "header", "content": "Mobile service band" },
    { "type": "checkbox", "id": "show_band", "label": "Show the band", "default": true },
    { "type": "image_picker", "id": "band_image", "label": "Photo", "info": "Landscape, 1420px wide or more. Empty: the bundled van photo." },
    { "type": "text", "id": "band_image_alt", "label": "Photo description", "info": "Empty: the photo's own description." },
    { "type": "text", "id": "band_tag", "label": "Tag", "default": "Free mobile service" },
    { "type": "text", "id": "band_heading", "label": "Heading", "default": "We come to you." },
    { "type": "text", "id": "band_highlight", "label": "Words on the red bar", "default": "to you." },
    { "type": "textarea", "id": "band_text", "label": "Text", "default": "Serving all of Louisiana. Same day or next day, in shop or mobile." },
    { "type": "text", "id": "band_cities", "label": "City chips", "info": "Separate with commas.", "default": "Lafayette, Baton Rouge, New Orleans, Alexandria" },
    { "type": "text", "id": "band_cities_label", "label": "City list description (screen readers)", "default": "Cities our technicians work from" },
    { "type": "text", "id": "band_btn_1_label", "label": "First button label", "default": "Get a quote" },
    { "type": "select", "id": "band_btn_1_action", "label": "First button goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "quote" },
    { "type": "text", "id": "band_btn_1_link", "label": "First button custom link" },
    { "type": "text", "id": "band_btn_2_label", "label": "Second button label", "info": "Empty on a call button: Call and the number." },
    { "type": "select", "id": "band_btn_2_action", "label": "Second button goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "call_lafayette" },
    { "type": "text", "id": "band_btn_2_link", "label": "Second button custom link" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id", "default": "services" }
  ],
  "blocks": [
    { "type": "service", "name": "Service", "settings": [
      { "type": "image_picker", "id": "image", "label": "Photo", "info": "Square, 1200px. Empty: the bundled photo picked below." },
      { "type": "select", "id": "bundled", "label": "Bundled photo", "options": [{"value": "none", "label": "None"}, {"value": "hero", "label": "Vans at the Lafayette shop"}, {"value": "trust", "label": "Technicians lifting a windshield"}, {"value": "svc-windshield", "label": "Windshield going on a Ford"}, {"value": "svc-chip", "label": "Star chip close up"}, {"value": "svc-back", "label": "Tesla, back glass out"}, {"value": "svc-adas", "label": "ADAS targets"}, {"value": "svc-door", "label": "Shattered door glass"}, {"value": "svc-fleet", "label": "Sprinter van in the shop"}, {"value": "svc-mobile", "label": "Black van outside the shop"}, {"value": "bleed-insurance", "label": "Windshield on a red SUV"}, {"value": "story", "label": "Fleet outside the storefront"}, {"value": "loc-lafayette", "label": "Lafayette shop front"}, {"value": "loc-kenner", "label": "Kenner shop entrance"}, {"value": "loc-nola-van", "label": "New Orleans van"}, {"value": "ba-before", "label": "Jeep, glass out"}, {"value": "ba-after", "label": "Jeep, glass in"}], "default": "none" },
      { "type": "text", "id": "image_alt", "label": "Photo description", "info": "Empty: the photo's own description." },
      { "type": "text", "id": "title", "label": "Title", "default": "Service" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "text", "id": "link", "label": "Link", "info": "Optional. The service's own page, for example /pages/windshield-replacement." },
      { "type": "select", "id": "dir", "label": "Photo reveal", "options": [{ "value": "left", "label": "From the left" }, { "value": "up", "label": "From below" }, { "value": "right", "label": "From the right" }, { "value": "iris", "label": "Iris" }], "default": "left" },
      { "type": "text", "id": "anchor_id", "label": "Anchor id", "info": "Footer and other links land on this card with #id. The six built-in ids are windshield, chip, back-glass, adas, door-glass and commercial." }
    ] }
  ],
  "presets": [{ "name": "Services grid" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

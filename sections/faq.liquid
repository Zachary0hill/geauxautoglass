{%- comment -%}
  Questions and answers as native disclosure rows. Every answer is in the HTML whether its
  row is open or closed, so search engines and AI assistants read all of them. Prints
  FAQPage structured data from the same rows; use one FAQ section per page.
{%- endcomment -%}
{%- liquid
  assign rows = 0
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign rows = rows | plus: 1
    endif
  endfor
-%}
<section class="sc-section paper{% if section.settings.ground == 'paper-2' %} paper--2{% endif %}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap">
    {%- render 'section-head', tag: section.settings.tag, heading: section.settings.heading, highlight: section.settings.highlight, text: section.settings.text -%}
    {%- if rows > 0 -%}
      <div class="faq" data-sc-in data-sc-stagger="60">
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            <details class="faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
              <summary><h3>{{ block.settings.question | escape }}</h3><span class="faq__mark" aria-hidden="true"></span></summary>
              <div class="faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.structured_data and rows > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- assign printed = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- if printed > 0 -%},{%- endif -%}
        {%- assign printed = printed | plus: 1 %}
    { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | strip_newlines | strip | json }} } }
      {%- endif -%}
    {%- endfor %}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "div",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good to know before you book." },
    { "type": "text", "id": "highlight", "label": "Words on the red bar", "info": "Optional. Must match words in the heading exactly." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "open_first", "label": "Start with the first question open", "default": true },
    { "type": "checkbox", "id": "structured_data", "label": "Tell search engines these are questions and answers", "info": "Use one FAQ section per page.", "default": true },
    { "type": "select", "id": "ground", "label": "Ground", "options": [{ "value": "paper", "label": "White" }, { "value": "paper-2", "label": "Off-white" }], "default": "paper" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id" }
  ],
  "blocks": [
    { "type": "question", "name": "Question", "settings": [
      { "type": "text", "id": "question", "label": "Question", "info": "Write it the way a customer would ask it.", "default": "Do you come to me?" },
      { "type": "richtext", "id": "answer", "label": "Answer", "info": "Answer in the first sentence." }
    ] }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

{%- comment -%}
  Newsletter: one field, one button.
  The customer form posts to Shopify with the newsletter tag; success and
  error states render server-side so it works without JavaScript.
{%- endcomment -%}
<section class="masthead br-section plate--{{ section.settings.color_scheme }}" data-sc-act="flow">
  {%- if section.settings.stamp != blank -%}<span class="masthead__stamp" aria-hidden="true">{{ section.settings.stamp | escape }}</span>{%- endif -%}
  {%- if section.settings.ghost != blank -%}<span class="masthead__ghost" aria-hidden="true">{{ section.settings.ghost | escape }}</span>{%- endif -%}
  <div class="page-width masthead__inner" data-sc-in data-sc-stagger="80">
    <div class="u-stack">
      {%- if section.settings.caption != blank -%}<p class="br-rule">{{ section.settings.caption | escape }}</p>{%- endif -%}
      <h2 class="br-display masthead__heading">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="u-stack">
      {%- if section.settings.text != blank -%}<div class="masthead__body br-body rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- form 'customer', class: 'masthead__form', id: 'BrNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form__message form__message--success" role="status">{% render 'icon', icon: 'check' %} {{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="masthead__row">
            <div class="field">
              <label class="visually-hidden" for="BrNewsletterEmail">{{ 'newsletter.label' | t }}</label>
              <input class="field__input" id="BrNewsletterEmail" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ 'newsletter.label' | t }}" required autocomplete="email"{% if form.errors %} aria-invalid="true" aria-describedby="BrNewsletterError"{% endif %}>
            </div>
            <button type="submit" class="btn" name="commit">{{ section.settings.button_label | default: 'Subscribe' | escape }}</button>
          </div>
          {%- if form.errors -%}
            <p class="form__message form__message--error" id="BrNewsletterError" role="alert">{% render 'icon', icon: 'error' %} {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.fine_print != blank -%}<p class="masthead__fine">{{ section.settings.fine_print | escape }}</p>{%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "stamp", "label": "Corner stamp", "default": "" },
    { "type": "text", "id": "ghost", "label": "Ghost numeral", "info": "Outlined, huge, off the right edge. Two characters at most.", "default": "01" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "News from the workshop." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New slabs, builds and store items, now and then.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Unsubscribe any time." },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [
        { "value": "accent", "label": "Accent" },
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Surface" },
        { "value": "pine", "label": "Pine" }
      ],
      "default": "accent"
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

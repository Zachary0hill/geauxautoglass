{%- comment -%}
  Structured data for search: the business on every page and the site name on
  the home page. The New Orleans shop prints its own AutoRepair block from the
  Location detail section. Product and article data stay in their own sections.

  Accepts:
  - seo_site: business name
  - seo_description: this page's description
{%- endcomment -%}
{%- liquid
  assign site_url = shop.url | default: request.origin
  assign biz_id = site_url | append: '/#business'
  capture tel
    render 'phone', phone: settings.phone_lafayette, as: 'e164'
  endcapture
  assign tel = tel | strip

  if settings.logo != blank
    assign biz_image = settings.logo | image_url: width: 600 | prepend: 'https:'
  else
    assign biz_image = 'logo.png' | asset_url | prepend: 'https:'
  endif

  # The business photo is a real picture of the shop or van, not the logo.
  if settings.social_image != blank
    assign biz_photo = settings.social_image | image_url: width: 1200 | prepend: 'https:'
  else
    assign biz_photo = 'hero.jpg' | asset_img_url: '1200x' | prepend: 'https:'
  endif

  assign services = ''
  assign service_lines = settings.seo_services | newline_to_br | strip_newlines | split: '<br />'
  for line in service_lines
    assign service = line | strip
    if service != blank
      if services != blank
        assign services = services | append: '|'
      endif
      assign services = services | append: service
    endif
  endfor
  assign services = services | split: '|'

  # Pages on a service template (page.service-*.json) describe one service.
  assign is_service_page = false
  if request.page_type == 'page'
    assign suffix_start = template.suffix | slice: 0, 8
    if suffix_start == 'service-'
      assign is_service_page = true
    endif
  endif

  assign areas = ''
  assign area_lines = settings.seo_areas_served | newline_to_br | strip_newlines | split: '<br />'
  for line in area_lines
    assign area = line | strip
    if area != blank
      if areas != blank
        assign areas = areas | append: '|'
      endif
      assign areas = areas | append: area
    endif
  endfor
  assign areas = areas | split: '|'

  assign same_as = ''
  assign social_keys = 'facebook,instagram,tiktok,yelp,bbb' | split: ','
  for key in social_keys
    assign setting_id = key | append: '_url'
    assign link = settings[setting_id]
    if link != blank
      if same_as != blank
        assign same_as = same_as | append: '|'
      endif
      assign same_as = same_as | append: link
    endif
  endfor
  assign same_as = same_as | split: '|'
-%}
{%- capture areas_json -%}
  [{%- for area in areas -%}{ "@type": "AdministrativeArea", "name": {{ area | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
{%- endcapture -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AutoRepair",
      "@id": {{ biz_id | json }},
      "name": {{ seo_site | json }},
      {%- if settings.seo_home_description != blank %}
      "description": {{ settings.seo_home_description | json }},
      {%- endif -%}
      {%- if tel != blank %}
      "telephone": {{ tel | json }},
      {%- endif -%}
      {%- if settings.email != blank %}
      "email": {{ settings.email | json }},
      {%- endif -%}
      {%- if settings.business_city != blank %}
      "address": {
        "@type": "PostalAddress",
        {%- if settings.business_street != blank %}
        "streetAddress": {{ settings.business_street | json }},
        {%- endif -%}
        {%- if settings.business_region != blank %}
        "addressRegion": {{ settings.business_region | json }},
        {%- endif -%}
        {%- if settings.business_postal != blank %}
        "postalCode": {{ settings.business_postal | json }},
        {%- endif %}
        "addressLocality": {{ settings.business_city | json }},
        "addressCountry": "US"
      },
      {%- endif -%}
      {%- if areas.size > 0 %}
      "areaServed": {{ areas_json | strip }},
      {%- endif -%}
      {%- if same_as.size > 0 %}
      "sameAs": {{ same_as | json }},
      {%- endif -%}
      {%- if settings.google_lafayette_url != blank %}
      "hasMap": {{ settings.google_lafayette_url | json }},
      {%- endif -%}
      {%- if services.size > 0 %}
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Auto glass services",
        "itemListElement": [
          {%- for service in services -%}
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": {{ service | json }}, "provider": { "@id": {{ biz_id | json }} } } }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      },
      {%- endif %}
      "image": {{ biz_photo | json }},
      "logo": {{ biz_image | json }},
      "url": {{ site_url | json }}
    }
    {%- if template.name == 'index' -%}
    ,
    {
      "@type": "WebSite",
      "@id": {{ site_url | append: '/#website' | json }},
      "name": {{ seo_site | json }},
      "url": {{ site_url | json }},
      "publisher": { "@id": {{ biz_id | json }} }
    }
    {%- endif %}
    {%- if is_service_page -%}
    ,
    {
      "@type": "Service",
      "@id": {{ canonical_url | append: '#service' | json }},
      "name": {{ page.title | json }},
      "serviceType": {{ page.title | json }},
      {%- if seo_description != blank %}
      "description": {{ seo_description | json }},
      {%- endif -%}
      {%- if areas.size > 0 %}
      "areaServed": {{ areas_json | strip }},
      {%- endif %}
      "provider": { "@id": {{ biz_id | json }} },
      "url": {{ canonical_url | json }}
    }
    {%- endif %}
    {%- comment -%}
      Breadcrumb trail for inner pages: Home, an optional parent, then this page.
      Mirrors the crumbs the page head shows.
    {%- endcomment -%}
    {%- liquid
      assign crumb_name = ''
      assign crumb_parent_name = ''
      assign crumb_parent_url = ''
      case request.page_type
        when 'page'
          assign crumb_name = page.title
          if template.suffix contains 'location' and template.suffix != 'locations' and pages['locations'].title != blank
            assign crumb_parent_name = pages['locations'].title
            assign crumb_parent_url = routes.root_url | append: 'pages/locations'
          endif
          if is_service_page and pages['services'].title != blank
            assign crumb_parent_name = pages['services'].title
            assign crumb_parent_url = routes.root_url | append: 'pages/services'
          endif
        when 'product'
          assign crumb_name = product.title
          assign crumb_parent_name = collections.all.title | default: 'Merchandise'
          assign crumb_parent_url = routes.all_products_collection_url
        when 'collection'
          assign crumb_name = collection.title
        when 'blog'
          assign crumb_name = blog.title
        when 'article'
          assign crumb_name = article.title
          assign crumb_parent_name = blog.title
          assign crumb_parent_url = blog.url
        when 'policy'
          assign crumb_name = page_title
      endcase
      assign crumb_pos = 2
    -%}
    {%- if crumb_name != blank -%}
    ,
    {
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ site_url | append: '/' | json }} },
        {%- if crumb_parent_name != blank and crumb_parent_url != blank %}
        { "@type": "ListItem", "position": 2, "name": {{ crumb_parent_name | json }}, "item": {{ site_url | append: crumb_parent_url | json }} },
        {%- assign crumb_pos = 3 -%}
        {%- endif %}
        { "@type": "ListItem", "position": {{ crumb_pos }}, "name": {{ crumb_name | json }}, "item": {{ canonical_url | json }} }
      ]
    }
    {%- endif %}
  ]
}
</script>

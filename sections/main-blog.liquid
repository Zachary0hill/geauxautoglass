<div class="page-width blog">
  <div class="u-stack">
    <p class="br-rule">{{ 'blogs.general.caption' | t }}</p>
  </div>
  {%- paginate blog.articles by section.settings.per_page -%}
    {%- if blog.articles.size > 0 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <article class="article-card">
            {%- if article.image -%}
              <div class="article-card__img">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 1100px) min(30vw, 370px), (min-width: 760px) 44vw, 90vw', alt: article.image.alt | default: article.title }}</div>
            {%- endif -%}
            <p class="article-card__meta">{{ article.published_at | date: format: 'date' }}{% if section.settings.show_author %} · {{ article.author }}{% endif %}</p>
            <h2 class="br-display article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            {%- if section.settings.show_excerpt -%}<p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>{%- endif -%}
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state"><h2 class="br-display empty-state__title">{{ 'blogs.general.empty' | t }}</h2></div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "class": "paper",
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    { "type": "range", "id": "per_page", "min": 3, "max": 24, "step": 3, "label": "Posts per page", "default": 12 },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true }
  ]
}
{% endschema %}

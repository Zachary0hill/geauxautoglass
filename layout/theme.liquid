{%- liquid
  comment
    The home page and the designed service pages (page templates with a suffix) run on the
    engine floor + design layer only. Shop templates add the commerce layer and the cart drawer.
  endcomment
  assign shop_layer = true
  if template.name == 'index'
    assign shop_layer = false
  elsif template.name == 'page' and template.suffix != blank and template.suffix != 'contact'
    assign shop_layer = false
  endif
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-br-motion="{% if settings.scroll_motion %}on{% else %}off{% endif %}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_canvas }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
  {%- endif -%}

  {%- if settings.use_brand_fonts -%}
    {{ 'display-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- comment -%} Body text and buttons sit above the fold on every page; without this they wait for the CSS and then swap. {%- endcomment -%}
    {{ 'text-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {%- else -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- unless settings.type_heading_font.system? -%}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}
  {%- endif -%}

  {% render 'seo' %}

  {{ content_for_header }}

  {{ 'scrollcraft.css' | asset_url | stylesheet_tag }}
  {%- if shop_layer -%}
    {{ 'gx-base.css' | asset_url | stylesheet_tag }}
    {{ 'gx-sections.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% render 'css-variables' %}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  <script>
    window.GX = {
      routes: {
        root: '{{ routes.root_url }}',
        cart: '{{ routes.cart_url }}',
        cartAdd: '{{ routes.cart_add_url }}',
        cartChange: '{{ routes.cart_change_url }}',
        cartUpdate: '{{ routes.cart_update_url }}',
        predictiveSearch: '{{ routes.predictive_search_url }}',
        search: '{{ routes.search_url }}'
      },
      moneyFormat: {{ shop.money_format | json }},
      strings: {
        addToCart: {{ 'products.product.add_to_cart' | t | json }},
        soldOut: {{ 'products.product.sold_out' | t | json }},
        unavailable: {{ 'products.product.unavailable' | t | json }},
        addedToCart: {{ 'products.product.added_to_cart' | t | json }},
        viewCart: {{ 'cart.general.view_cart' | t | json }},
        cartError: {{ 'cart.general.error' | t | json }},
        cartEmpty: {{ 'cart.general.empty' | t | json }}
      },
      quoteUrl: {{ settings.quote_url | json }},
      phones: { lafayette: {{ settings.phone_lafayette | json }}, new_orleans: {{ settings.phone_new_orleans | json }} },
      cartType: {{ settings.cart_type | json }},
      motion: {{ settings.scroll_motion | json }},
      designMode: {% if request.design_mode %}true{% else %}false{% endif %}
    };
  </script>
  {%- comment -%} Order matters: phone.js rewrites act attributes, theme.js mounts the engine, then the page scripts. {%- endcomment -%}
  <script src="{{ 'phone.js' | asset_url }}" defer></script>
  <script src="{{ 'scrollcraft.js' | asset_url }}" defer></script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'gx-global.js' | asset_url }}" defer></script>
  {%- if settings.cart_type == 'drawer' and shop_layer -%}<script src="{{ 'gx-cart-drawer.js' | asset_url }}" defer></script>{%- endif -%}
</head>

<body class="template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ request.page_type | handle }}-{{ template.suffix | handle }}{% endif %}{% unless template.name == 'index' %} page-sub{% endunless %}">
  <a class="skip-link" href="#top">{{ 'accessibility.skip_to_content' | t }}</a>
  <span data-sc-progress></span>
  {%- if settings.show_grain -%}<div class="sc-grain" aria-hidden="true"></div>{%- endif -%}

  {% sections 'header-group' %}

  <main id="top" class="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.cart_type == 'drawer' and shop_layer -%}
    {% section 'cart-drawer' %}
  {%- endif -%}

  <div class="br-toast" id="BrToast" role="status" aria-live="polite" hidden>
    <div class="br-toast__inner">
      <p class="br-toast__text"></p>
      <a class="br-toast__link" href="{{ routes.cart_url }}">{{ 'cart.general.view_cart' | t }}</a>
      <button type="button" class="br-toast__close" aria-label="{{ 'accessibility.close' | t }}">{% render 'icon', icon: 'close' %}</button>
    </div>
  </div>

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
  </ul>
</body>
</html>

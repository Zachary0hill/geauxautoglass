    "faq": {
      "type": "faq",
      "blocks": {
        "question1": {
          "type": "question",
          "settings": {
            "question": "Can my chip be repaired?",
            "answer": "<p>Minor chips usually can. Larger chips, long cracks, or damage that has spread may need a new windshield. Request a quote and we will tell you which yours needs.</p>"
          }
        },
        "question2": {
          "type": "question",
          "settings": {
            "question": "Do you come to me for a chip repair?",
            "answer": "<p>Yes. Mobile service is free: we come to your home or work, or you can bring the vehicle to our shop at 409A Mecca Street in Lafayette or 2837 Tifton St Unit B in Kenner.</p>"
          }
        },
        "question3": {
          "type": "question",
          "settings": {
            "question": "How soon can you repair it?",
            "answer": "<p>Same day or next day. We work by appointment, so call or request a quote to get on the schedule.</p>"
          }
        },
        "question4": {
          "type": "question",
          "settings": {
            "question": "Does insurance cover chip repair?",
            "answer": "<p>Comprehensive coverage covers glass damage. Call your insurance to confirm your coverage, then use the company name Geaux Auto Glass to begin the filing, and we handle the rest. <a href=\"/pages/insurance\">See the four steps to file a claim</a>.</p>"
          }
        },
        "question5": {
          "type": "question",
          "settings": {
            "question": "What if the chip has turned into a crack?",
            "answer": "<p>Then the windshield may need replacing. We replace windshields too, the same day or the next day. <a href=\"/pages/windshield-replacement\">About windshield replacement</a>.</p>"
          }
        }
      },

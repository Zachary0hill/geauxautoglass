{%- liquid
  assign og_site = seo_site | default: shop.name
  assign og_title = seo_title | default: page_title | default: og_site
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: page_description | default: shop.description | default: og_site

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}
<meta property="og:site_name" content="{{ og_site | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- comment -%}
  Share image: the page's own image, else the service card for page.service-* templates
  (og-service-*.jpg), else Theme settings > Search and local SEO > Share image, else the
  bundled branded card (og-share.jpg). Cards are 1200 x 630, built by _dev/og-share/build.py.
  Every page gets one, so links never unfurl bare.
{%- endcomment -%}
{%- liquid
  assign og_source = page_image
  assign og_card = 'og-share.jpg'
  assign og_card_alt = og_site | append: ': mobile windshield replacement. We come to you.'
  if og_source == blank and template.name == 'page' and template.suffix contains 'service-'
    assign og_card = 'og-' | append: template.suffix | append: '.jpg'
    assign og_card_alt = og_title
  elsif og_source == blank
    assign og_source = settings.social_image
  endif
  if og_source != blank
    assign og_image = og_source | image_url: width: 1200 | prepend: 'https:'
    assign og_image_width = og_source.width | at_most: 1200
    assign og_image_height = og_image_width | divided_by: og_source.aspect_ratio | round
    assign og_image_alt = og_source.alt | default: og_title
  else
    assign og_image = og_card | asset_url | prepend: 'https:'
    assign og_image_width = 1200
    assign og_image_height = 630
    assign og_image_alt = og_card_alt
  endif
-%}
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:secure_url" content="{{ og_image }}">
<meta property="og:image:width" content="{{ og_image_width }}">
<meta property="og:image:height" content="{{ og_image_height }}">
<meta property="og:image:alt" content="{{ og_image_alt | escape }}">
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
<meta name="twitter:image" content="{{ og_image }}">
<meta name="twitter:image:alt" content="{{ og_image_alt | escape }}">

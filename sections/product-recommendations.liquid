<div class="recommendations" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="br-head">
        <div class="br-head__text">
          {%- if section.settings.caption != blank -%}<p class="br-rule">{{ section.settings.caption | escape }}</p>{%- endif -%}
          <h2 class="br-display br-head__heading">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <div class="product-grid product-grid--4">
        {%- for p in recommendations.products -%}
          {% render 'product-card', product: p %}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>
<script>
  (function () {
    var el = document.currentScript.previousElementSibling;
    if (!el || el.children.length) return;
    function load() {
      fetch(el.dataset.url).then(function (r) { return r.text(); }).then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var inner = doc.querySelector('[data-recommendations]');
        if (inner && inner.children.length) { el.innerHTML = inner.innerHTML; if (window.GX && window.GX.init) window.GX.init(el); }
      }).catch(function () {});
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { io.disconnect(); load(); } }); }, { rootMargin: '0px 0px 400px 0px' });
      io.observe(el);
    } else load();
  })();
</script>

{% schema %}
{
  "class": "paper",
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "From the store" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Maximum products", "default": 4 }
  ]
}
{% endschema %}

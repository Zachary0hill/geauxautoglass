{%- liquid
  assign on_shop = false
  if template.name == 'collection' or template.name == 'product' or template.name == 'cart'
    assign on_shop = true
  endif
  assign on_locations = false
  if template.name == 'page' and template.suffix contains 'location'
    assign on_locations = true
  endif
  assign cart_open = false
  if settings.cart_type == 'drawer' and template.name != 'cart'
    assign cart_open = true
  endif
  assign home_href = routes.root_url
  if template.name == 'index'
    assign home_href = '#top'
  endif
  assign here = template.name
  if template.suffix != blank
    assign here = template.name | append: '.' | append: template.suffix
  endif
  assign biz = settings.brand_name | default: shop.name
  capture tel
    render 'phone', phone: settings.phone_lafayette
  endcapture
  assign tel = tel | strip
  assign phone_menu = false
  if section.settings.show_menu_button
    if section.settings.menu != blank and section.settings.menu.links.size > 0
      assign phone_menu = true
    elsif section.blocks.size > 0
      assign phone_menu = true
    endif
  endif
-%}
<header class="bar{% if phone_menu %} bar--menu{% endif %}">
  <a class="bar__mark" href="{{ home_href }}" aria-label="{{ 'sections.header.home_label' | t: name: biz | escape }}">
    {%- if settings.logo != blank -%}
      <img class="bar__logo" src="{{ settings.logo | image_url: width: 480 }}" srcset="{{ settings.logo | image_url: width: 240 }} 240w, {{ settings.logo | image_url: width: 480 }} 480w" sizes="230px" alt="{{ settings.logo.alt | default: biz | escape }}" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" loading="eager">
    {%- else -%}
      <img class="bar__logo" src="{{ 'logo.png' | asset_img_url: '480x' }}" srcset="{{ 'logo.png' | asset_img_url: '240x' }} 240w, {{ 'logo.png' | asset_img_url: '480x' }} 480w" sizes="230px" alt="{{ 'sections.header.logo_alt' | t | escape }}" width="1200" height="202" loading="eager">
    {%- endif -%}
    {%- if settings.logo_compact != blank -%}
      <img class="bar__logo-compact" src="{{ settings.logo_compact | image_url: width: 480 }}" srcset="{{ settings.logo_compact | image_url: width: 240 }} 240w, {{ settings.logo_compact | image_url: width: 480 }} 480w" sizes="225px" alt="" width="{{ settings.logo_compact.width }}" height="{{ settings.logo_compact.height }}" loading="eager">
    {%- else -%}
      <img class="bar__logo-compact" src="{{ 'logo-compact.png' | asset_img_url: '480x' }}" srcset="{{ 'logo-compact.png' | asset_img_url: '240x' }} 240w, {{ 'logo-compact.png' | asset_img_url: '480x' }} 480w" sizes="225px" alt="" width="1200" height="141" loading="eager">
    {%- endif -%}
  </a>
  <nav class="bar__nav" aria-label="{{ 'sections.header.primary' | t }}">
    {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}"{% if link.current or link.child_current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endfor -%}
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_current = false
          if block.settings.current_on != 'none'
            if block.settings.current_on == here
              assign is_current = true
            elsif block.settings.current_on == 'shop' and on_shop
              assign is_current = true
            elsif block.settings.current_on == 'locations' and on_locations
              assign is_current = true
            endif
          endif
          render 'action-link', action: block.settings.action, label: block.settings.label, url: block.settings.link, current: is_current, attrs: block.shopify_attributes
        -%}
      {%- endfor -%}
    {%- endif -%}
  </nav>
  {%- if section.settings.show_phone and settings.phone_lafayette != blank -%}
    <a class="bar__call" href="{{ tel }}">{{ settings.phone_lafayette | escape }}</a>
  {%- endif -%}
  {%- if section.settings.show_cart and on_shop -%}
    <a class="bar__cart" href="{{ routes.cart_url }}"{% if cart_open %} data-cart-open{% endif %}>{{ 'sections.header.cart' | t }} (<span data-cart-count>{{ cart.item_count }}</span>)</a>
  {%- endif -%}
  {%- render 'action-link', action: section.settings.cta_action, label: section.settings.cta_label, url: section.settings.cta_link, class: 'bar__cta' -%}
  {%- if phone_menu -%}
    <button type="button" class="bar__menu" data-menu-open aria-expanded="false" aria-controls="PhoneMenu" aria-label="{{ 'sections.header.menu' | t }}">
      <svg class="bar__menu-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
      <svg class="bar__menu-shut" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19"/></svg>
    </button>
  {%- endif -%}
</header>

{%- comment -%} Phone menu: the header links, opened from the button at the top right. It sits under the bar and above the page; the tab bar stays in reach. {%- endcomment -%}
{%- if phone_menu -%}
  <nav class="mmenu" id="PhoneMenu" aria-label="{{ 'sections.header.menu' | t }}" hidden>
    <div class="mmenu__list">
      {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.current or link.child_current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_current = false
            if block.settings.current_on != 'none'
              if block.settings.current_on == here
                assign is_current = true
              elsif block.settings.current_on == 'shop' and on_shop
                assign is_current = true
              endif
            endif
            render 'action-link', action: block.settings.action, label: block.settings.label, url: block.settings.link, current: is_current
          -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </nav>
{%- endif -%}

{%- if section.settings.show_tabbar -%}
  <nav class="tabbar" aria-label="{{ 'sections.header.quick_actions' | t }}">
    <a href="{{ tel }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
      <span>{{ section.settings.tab_call_label | escape }}</span>
    </a>
    {%- liquid
      assign tab_href = settings.quote_url
      assign tab_new = true
      if section.settings.cta_action == 'custom'
        assign tab_href = section.settings.cta_link
        assign tab_new = false
      elsif section.settings.cta_action == 'enterprise_form'
        assign tab_href = settings.enterprise_form_url
      elsif section.settings.cta_action == 'shop'
        assign tab_href = routes.all_products_collection_url
        assign tab_new = false
      endif
    -%}
    <a class="tabbar__main" href="{{ tab_href }}"{% if tab_new %} target="_blank" rel="noopener"{% endif %}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9l2.5-4.5h11L20 9"/><path d="M4 9h16l-1.5 9h-13z"/><path d="M9 13h6"/></svg>
      <span>{{ section.settings.tab_cta_label | default: section.settings.cta_label | escape }}</span>
    </a>
    <a href="{{ section.settings.tab_visit_link | default: '/pages/locations' }}">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 0 0-14 0c0 4.8 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <span>{{ section.settings.tab_visit_label | escape }}</span>
    </a>
  </nav>

{%- endif -%}

{% schema %}
{
  "name": "Header",
  "max_blocks": 7,
  "settings": [
    { "type": "paragraph", "content": "Logos are in Theme settings > Branding. The phone number and the quote form link are in Theme settings > Business." },
    { "type": "link_list", "id": "menu", "label": "Menu", "info": "Optional. When empty, the header uses the links added as blocks below." },
    { "type": "checkbox", "id": "show_phone", "label": "Show the phone number", "info": "Wide screens only. It hides under 1180px.", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show the cart link", "info": "On the merchandise, product and cart pages only.", "default": true },
    { "type": "checkbox", "id": "show_menu_button", "label": "Show a menu button on phones", "info": "Top right. Opens the header links. Phones have no other menu.", "default": true },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Label", "default": "Get a quote" },
    { "type": "select", "id": "cta_action", "label": "Goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "quote" },
    { "type": "text", "id": "cta_link", "label": "Custom link" },
    { "type": "header", "content": "Phone tab bar" },
    { "type": "checkbox", "id": "show_tabbar", "label": "Show the tab bar on phones", "default": true },
    { "type": "text", "id": "tab_call_label", "label": "Call label", "default": "Call" },
    { "type": "text", "id": "tab_cta_label", "label": "Middle label", "info": "Empty: the button label above.", "default": "Get a quote" },
    { "type": "text", "id": "tab_visit_label", "label": "Third label", "default": "Visit" },
    { "type": "text", "id": "tab_visit_link", "label": "Third link", "default": "/pages/locations" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Link" },
        { "type": "select", "id": "action", "label": "Goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "custom" },
        { "type": "text", "id": "link", "label": "Custom link", "info": "Home page sections look like /#services. Pages look like /pages/services." },
        { "type": "select", "id": "current_on", "label": "Highlight on", "options": [
          { "value": "none", "label": "Never" },
          { "value": "page.services", "label": "Services page" },
          { "value": "page.insurance", "label": "Insurance page" },
          { "value": "page.enterprise", "label": "Enterprise page" },
          { "value": "page.location", "label": "Location page" },
          { "value": "locations", "label": "Locations page and each location page" },
          { "value": "shop", "label": "Merchandise, product and cart pages" }
        ], "default": "none" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}

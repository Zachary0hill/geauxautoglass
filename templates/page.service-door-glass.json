      "settings": {
        "bundled": "story",
        "image_alt": "",
        "tag": "What to expect",
        "heading": "Broken side window, replaced fast.",
        "highlight": "replaced fast.",
        "text": "Geaux Auto Glass replaces door glass on domestic and foreign cars, SUVs and trucks. Side windows are usually tempered glass, which shatters into small pieces when it breaks, and much of it falls inside the door. Replacing it means clearing that glass out and fitting a new window that rolls up and down like the original. Tell us the year, make and model and which door when you request a quote. Mobile service is free, or bring the vehicle to our shop in Lafayette or Kenner, the same day or the next day by appointment.",
        "link_label": "",
        "link": "",
        "ground": "paper",
        "anchor_id": ""
      }
    },

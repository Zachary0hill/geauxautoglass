    "faq": {
      "type": "faq",
      "blocks": {
        "question1": {
          "type": "question",
          "settings": {
            "question": "Can you replace my windshield at my home or work?",
            "answer": "<p>Yes. Mobile service is free: we come to your home or work, or you can bring the vehicle to our shop at 409A Mecca Street in Lafayette or 2837 Tifton St Unit B in Kenner.</p>"
          }
        },
        "question2": {
          "type": "question",
          "settings": {
            "question": "How soon can you replace my windshield?",
            "answer": "<p>Same day or next day. We work by appointment, so call or request a quote to get on the schedule.</p>"
          }
        },
        "question3": {
          "type": "question",
          "settings": {
            "question": "Will my insurance pay for a new windshield?",
            "answer": "<p>Comprehensive coverage covers glass damage. Call your insurance, use the company name Geaux Auto Glass to begin the filing, and we handle the rest. <a href=\"/pages/insurance\">See the four steps to file a claim</a>.</p>"
          }
        },
        "question4": {
          "type": "question",
          "settings": {
            "question": "Should I repair the chip or replace the windshield?",
            "answer": "<p>Minor chips can often be repaired. Larger damage, or a crack that has spread, usually needs a new windshield. Request a quote and we will tell you which yours needs. <a href=\"/pages/chip-repair\">About chip repair</a>.</p>"
          }
        },
        "question5": {
          "type": "question",
          "settings": {
            "question": "Do I need ADAS recalibration after a windshield replacement?",
            "answer": "<p>If your vehicle has driver-assist features that use a camera mounted on the windshield, such as lane keeping or automatic emergency braking, the camera usually needs recalibrating after the glass is replaced. We recalibrate ADAS on cars, SUVs and trucks. <a href=\"/pages/adas-recalibration\">About ADAS recalibration</a>.</p>"
          }
        },
        "question6": {
          "type": "question",
          "settings": {
            "question": "Which vehicles do you work on?",
            "answer": "<p>Cars, SUVs and trucks, domestic and foreign, personal and commercial.</p>"
          }
        }
      },

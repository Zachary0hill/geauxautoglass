{%- comment -%} Dark linked tiles with a number or label, a title, one line and a round arrow. {%- endcomment -%}
<section class="sc-section paper{% if section.settings.ground == 'paper-2' %} paper--2{% endif %}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap">
    {%- render 'section-head', tag: section.settings.tag, heading: section.settings.heading, highlight: section.settings.highlight, text: section.settings.text -%}
    {%- if section.blocks.size > 0 -%}
      <div class="tiles{% if section.settings.columns == '3' %} tiles--3{% endif %}" data-sc-in data-sc-stagger="90">
        {%- for block in section.blocks -%}
          {%- liquid
            capture href
              render 'action-href', action: block.settings.action, url: block.settings.link
            endcapture
            assign href = href | strip
            assign scheme = href | slice: 0, 4
            assign label = block.settings.label
            if label == blank
              assign label = forloop.index | prepend: '0'
            endif
            assign line = block.settings.text
            if line == blank
              if block.settings.action == 'text_lafayette'
                capture line
                  render 'phone', phone: settings.phone_lafayette, as: 'van'
                endcapture
              elsif block.settings.action == 'call_lafayette'
                assign line = settings.phone_lafayette
              elsif block.settings.action == 'call_new_orleans'
                assign line = settings.phone_new_orleans
              elsif block.settings.action == 'enterprise_email'
                assign line = settings.enterprise_email
              elsif block.settings.action == 'email'
                assign line = settings.email
              endif
            endif
            assign line = line | strip
            assign title = block.settings.title | escape
            if block.settings.keep != blank
              assign needle = block.settings.keep | escape
              assign wrapped = '<span class="hl--keep">' | append: needle | append: '</span>'
              assign title = title | replace_first: needle, wrapped
            endif
          -%}
          {%- if href != blank -%}
            <a class="tile" href="{{ href }}"{% if scheme == 'http' %} target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}><span class="tile__n">{{ label | escape }}</span><h3>{{ title }}</h3>{% if line != blank %}<p>{{ line | escape }}</p>{% endif %}<span class="tile__go" aria-hidden="true">{% render 'arrow-go' %}</span></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Link tiles",
  "tag": "div",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "Programs" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "text", "id": "highlight", "label": "Words on the red bar", "info": "Optional. Must match words in the heading exactly." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "2" },
    { "type": "select", "id": "ground", "label": "Ground", "options": [{ "value": "paper", "label": "White" }, { "value": "paper-2", "label": "Off-white" }], "default": "paper" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "text", "id": "label", "label": "Small label", "info": "Empty: the tile's number (01, 02...)." },
      { "type": "text", "id": "title", "label": "Title", "default": "Title" },
      { "type": "text", "id": "keep", "label": "Words kept on one line", "info": "Optional. Must match words in the title exactly." },
      { "type": "text", "id": "text", "label": "Line", "info": "Empty on a call, text or email tile: the number or address from Theme settings." },
      { "type": "select", "id": "action", "label": "Goes to", "options": [{"value": "quote", "label": "Quote form"}, {"value": "call_lafayette", "label": "Call Lafayette"}, {"value": "call_new_orleans", "label": "Call New Orleans"}, {"value": "text_lafayette", "label": "Text Lafayette"}, {"value": "email", "label": "Email"}, {"value": "enterprise_email", "label": "Enterprise email"}, {"value": "enterprise_form", "label": "Enterprise claim form"}, {"value": "enterprise_photo", "label": "Enterprise photo upload"}, {"value": "shop", "label": "Merchandise (all products)"}, {"value": "google_lafayette", "label": "Google, Lafayette"}, {"value": "google_new_orleans", "label": "Google, New Orleans"}, {"value": "custom", "label": "Custom link (below)"}], "default": "custom" },
      { "type": "text", "id": "link", "label": "Custom link" }
    ] }
  ],
  "presets": [{ "name": "Link tiles" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

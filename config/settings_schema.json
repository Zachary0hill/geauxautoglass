  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1032,
        "max": 1792,
        "step": 40,
        "unit": "px",
        "label": "Page width",
        "default": 1312
      },
      {
        "type": "range",
        "id": "corner_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 4,
        "info": "Buttons and chips. Cards and photos use twice this value."
      }
    ]
  },

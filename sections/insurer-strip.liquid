{%- comment -%} Carrier logos in glass panes. The glare on each pane follows the scroll. {%- endcomment -%}
<section class="strip"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} data-sc-act="flow" data-type-only data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap">
    {%- if section.settings.heading != blank -%}<p class="strip__h" data-sc-in>{{ section.settings.heading | escape }}</p>{%- endif -%}
    <ul class="panes glint">
      {%- for block in section.blocks -%}
        {%- liquid
          assign file = ''
          assign w = 200
          assign h = 50
          case block.settings.bundled
            when 'statefarm'
              assign file = 'carrier-statefarm.svg'
              assign w = 200
              assign h = 28
            when 'progressive'
              assign file = 'carrier-progressive.svg'
              assign w = 454
              assign h = 55
            when 'geico'
              assign file = 'carrier-geico.svg'
              assign w = 847
              assign h = 149
            when 'allstate'
              assign file = 'carrier-allstate.svg'
              assign w = 1547
              assign h = 328
            when 'libertymutual'
              assign file = 'carrier-libertymutual.svg'
              assign w = 1024
              assign h = 245
          endcase
        -%}
        <li class="pane" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img class="pane__logo pane__logo--{{ block.settings.size }}" src="{{ block.settings.image | image_url: width: 400 }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" alt="{{ block.settings.name | escape }}" loading="lazy">
          {%- elsif file != blank -%}
            <img class="pane__logo pane__logo--{{ block.settings.size }}" src="{{ file | asset_url }}" width="{{ w }}" height="{{ h }}" alt="{{ block.settings.name | escape }}" loading="lazy">
          {%- else -%}
            <span class="pane__logo strip__h">{{ block.settings.name | escape }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Insurer strip",
  "tag": "div",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "We work with all insurance providers" },
    { "type": "paragraph", "content": "Five panes fill the row. On phones the fifth spans both columns." },
    { "type": "text", "id": "anchor_id", "label": "Anchor id" }
  ],
  "blocks": [
    {
      "type": "carrier",
      "name": "Carrier",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Carrier" },
        { "type": "image_picker", "id": "image", "label": "Logo", "info": "SVG or transparent PNG. It is shown in white. Empty: the bundled logo picked below." },
        { "type": "select", "id": "bundled", "label": "Bundled logo", "options": [
          { "value": "none", "label": "None" },
          { "value": "statefarm", "label": "State Farm" },
          { "value": "progressive", "label": "Progressive" },
          { "value": "geico", "label": "GEICO" },
          { "value": "allstate", "label": "Allstate" },
          { "value": "libertymutual", "label": "Liberty Mutual" }
        ], "default": "none" },
        { "type": "select", "id": "size", "label": "Logo shape", "options": [
          { "value": "w", "label": "Wide wordmark" },
          { "value": "m", "label": "Medium" },
          { "value": "t", "label": "Tall or stacked" }
        ], "default": "m" }
      ]
    }
  ],
  "presets": [{ "name": "Insurer strip", "blocks": [
    { "type": "carrier", "settings": { "name": "State Farm", "bundled": "statefarm", "size": "w" } },
    { "type": "carrier", "settings": { "name": "Progressive", "bundled": "progressive", "size": "w" } },
    { "type": "carrier", "settings": { "name": "GEICO", "bundled": "geico", "size": "m" } },
    { "type": "carrier", "settings": { "name": "Allstate", "bundled": "allstate", "size": "m" } },
    { "type": "carrier", "settings": { "name": "Liberty Mutual", "bundled": "libertymutual", "size": "t" } }
  ] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

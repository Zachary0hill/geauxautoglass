    "faq": {
      "type": "faq",
      "blocks": {
        "question1": {
          "type": "question",
          "settings": {
            "question": "Can you replace my side window at my home or work?",
            "answer": "<p>Yes. Mobile service is free: we come to your home or work, or you can bring the vehicle to our shop at 409A Mecca Street in Lafayette or 2837 Tifton St Unit B in Kenner.</p>"
          }
        },
        "question2": {
          "type": "question",
          "settings": {
            "question": "How soon can you replace it?",
            "answer": "<p>Same day or next day. We work by appointment, so call or request a quote to get on the schedule.</p>"
          }
        },
        "question3": {
          "type": "question",
          "settings": {
            "question": "What should I do until it is replaced?",
            "answer": "<p>Brush loose glass off the seat carefully, cover the opening with plastic and tape to keep rain out, and get on the schedule. We replace door glass the same day or the next day.</p>"
          }
        },
        "question4": {
          "type": "question",
          "settings": {
            "question": "Will my insurance pay for new door glass?",
            "answer": "<p>Comprehensive coverage covers glass damage. Call your insurance, use the company name Geaux Auto Glass to begin the filing, and we handle the rest. <a href=\"/pages/insurance\">See the four steps to file a claim</a>.</p>"
          }
        },
        "question5": {
          "type": "question",
          "settings": {
            "question": "Which vehicles do you work on?",
            "answer": "<p>Domestic and foreign cars, SUVs and trucks, personal and commercial.</p>"
          }
        }
      },

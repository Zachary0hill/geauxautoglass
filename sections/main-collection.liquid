{%- comment -%}
  Merch grid: every item of the collection on one page, grouped by product type, with
  filter chips that hide other types without a reload (theme.js).
  Each "Product type" block maps a Shopify product type to its labels and sets the group order.
  Products with a type that has no block come last under their own type name.
{%- endcomment -%}
{%- liquid
  assign groups = section.blocks | where: 'type', 'group'
  assign prefix = section.settings.strip_prefix
  assign known = '|'
  for block in groups
    assign known = known | append: block.settings.product_type | append: '|'
  endfor
-%}
<section class="merch paper" data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap">
    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        {%- liquid
          assign other_count = 0
          for product in collection.products
            assign needle = '|' | append: product.type | append: '|'
            unless known contains needle
              assign other_count = other_count | plus: 1
            endunless
          endfor
        -%}
        {%- if section.settings.show_filter and groups.size > 0 -%}
          <div class="merch__top">
            <div class="merch__bar" role="group" aria-label="{{ 'sections.merch.filter_label' | t }}">
              <button class="chip" type="button" data-filter="all" aria-pressed="true">{{ 'sections.merch.all' | t }} <b>{{ collection.products.size }}</b></button>
              {%- for block in groups -%}
                {%- assign matches = collection.products | where: 'type', block.settings.product_type -%}
                {%- if matches.size > 0 -%}
                  <button class="chip" type="button" data-filter="{{ block.settings.product_type | handle }}" aria-pressed="false" {{ block.shopify_attributes }}>{{ block.settings.chip | default: block.settings.product_type | escape }} <b>{{ matches.size }}</b></button>
                {%- endif -%}
              {%- endfor -%}
              {%- if other_count > 0 -%}
                <button class="chip" type="button" data-filter="other" aria-pressed="false">{{ section.settings.other_label | escape }} <b>{{ other_count }}</b></button>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
        <div class="merch__grid" id="merch-grid">
          {%- for block in groups -%}
            {%- for product in collection.products -%}
              {%- if product.type == block.settings.product_type -%}
                {%- render 'merch-item', product: product, type_key: block.settings.product_type, type_label: block.settings.label, strip_prefix: prefix, strip_word: block.settings.strip_word -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
          {%- for product in collection.products -%}
            {%- assign needle = '|' | append: product.type | append: '|' -%}
            {%- unless known contains needle -%}
              {%- render 'merch-item', product: product, type_key: 'other', type_label: product.type, strip_prefix: prefix, strip_word: '' -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.note != blank -%}<p class="merch__note">{{ section.settings.note | escape }}</p>{%- endif -%}
        {%- if paginate.pages > 1 -%}
          {%- render 'pagination', paginate: paginate -%}
        {%- endif -%}
      {%- else -%}
        <p class="merch__note">{{ 'sections.merch.empty' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Merch grid",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "range", "id": "per_page", "min": 10, "max": 50, "step": 5, "label": "Products per page", "info": "50 shows the whole catalog on one page, so the filter chips cover every item.", "default": 50 },
    { "type": "checkbox", "id": "show_filter", "label": "Show the filter chips", "default": true },
    { "type": "text", "id": "strip_prefix", "label": "Words dropped from the start of product names", "info": "\"Geaux Auto Glass Hoodie - Web Edition\" shows as \"Web Edition\".", "default": "Geaux Auto Glass" },
    { "type": "text", "id": "other_label", "label": "Chip for other product types", "default": "Other" },
    { "type": "text", "id": "note", "label": "Note under the grid", "default": "Every item opens in the Geaux Auto Glass store." }
  ],
  "blocks": [
    { "type": "group", "name": "Product type", "settings": [
      { "type": "text", "id": "product_type", "label": "Product type in Shopify", "info": "Exactly as it is written on the product, for example T-Shirt.", "default": "T-Shirt" },
      { "type": "text", "id": "label", "label": "Label on the card", "default": "T-shirt" },
      { "type": "text", "id": "chip", "label": "Label on the filter chip", "default": "T-shirts" },
      { "type": "text", "id": "strip_word", "label": "Word dropped from product names", "info": "Optional, for example Hoodie." }
    ] }
  ]
}
{% endschema %}

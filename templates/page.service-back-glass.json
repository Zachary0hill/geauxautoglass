    "faq": {
      "type": "faq",
      "blocks": {
        "question1": {
          "type": "question",
          "settings": {
            "question": "Can a broken back glass be repaired?",
            "answer": "<p>Usually not. Most rear windows are tempered glass, which breaks into small pieces, so the window is replaced. Request a quote and we will confirm for your vehicle.</p>"
          }
        },
        "question2": {
          "type": "question",
          "settings": {
            "question": "What should I do until it is replaced?",
            "answer": "<p>Brush loose glass off the seats carefully, cover the opening with plastic and tape to keep rain out, and get on the schedule. We replace back glass the same day or the next day.</p>"
          }
        },
        "question3": {
          "type": "question",
          "settings": {
            "question": "Will my insurance pay for a new back glass?",
            "answer": "<p>Comprehensive coverage covers glass damage. Call your insurance, use the company name Geaux Auto Glass to begin the filing, and we handle the rest. <a href=\"/pages/insurance\">See the four steps to file a claim</a>.</p>"
          }
        },
        "question4": {
          "type": "question",
          "settings": {
            "question": "Can you replace it at my home or work?",
            "answer": "<p>Yes. Mobile service is free: we come to your home or work, or you can bring the vehicle to our shop at 409A Mecca Street in Lafayette or 2837 Tifton St Unit B in Kenner.</p>"
          }
        },
        "question5": {
          "type": "question",
          "settings": {
            "question": "Which vehicles do you work on?",
            "answer": "<p>All vehicle types: cars, SUVs and trucks, domestic and foreign, personal and commercial.</p>"
          }
        }
      },

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{{ settings.color_canvas }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">{%- else -%}<link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">{%- endif -%}
  <title>{{ shop.name }}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {% render 'meta-tags' %}
  {{ content_for_header }}
  {{ 'scrollcraft.css' | asset_url | stylesheet_tag }}
  {{ 'gx-base.css' | asset_url | stylesheet_tag }}
  {{ 'gx-sections.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {% render 'css-variables' %}
</head>
<body class="template-password">
  <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
</body>
</html>

{%- comment -%} Boxed numbered steps, two columns. {%- endcomment -%}
<section class="sc-section paper{% if section.settings.ground == 'paper-2' %} paper--2{% endif %}"{% if section.settings.anchor_id != blank %} id="{{ section.settings.anchor_id | handle }}"{% endif %} data-sc-act="flow" data-sc-drift="{{ settings.color_canvas }}">
  <div class="sc-wrap">
    {%- render 'section-head', tag: section.settings.tag, heading: section.settings.heading, highlight: section.settings.highlight, text: section.settings.text -%}
    {%- if section.blocks.size > 0 -%}
      <ol class="steps" data-sc-in data-sc-stagger="90">
        {%- for block in section.blocks -%}
          <li class="step" data-type-only {{ block.shopify_attributes }}><span class="step__n">{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3>{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}</li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag", "default": "How to file" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps to a covered repair." },
    { "type": "text", "id": "highlight", "label": "Words on the red bar", "info": "Optional. Must match words in the heading exactly.", "default": "covered" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "select", "id": "ground", "label": "Ground", "options": [{ "value": "paper", "label": "White" }, { "value": "paper-2", "label": "Off-white" }], "default": "paper" },
    { "type": "text", "id": "anchor_id", "label": "Anchor id" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text" }
    ] }
  ],
  "presets": [{ "name": "Steps", "blocks": [{ "type": "step" }, { "type": "step" }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}

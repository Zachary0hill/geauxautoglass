<div class="page-width contact">
  <div class="contact__inner">
    <div class="u-stack">
      <p class="br-rule">{{ section.settings.caption | escape }}</p>
      <h2 class="br-display contact__title">{{ section.settings.heading | default: page.title | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="br-body rte">{{ section.settings.text }}</div>{%- elsif page.content != blank -%}<div class="br-body rte">{{ page.content }}</div>{%- endif -%}
    </div>

    {%- form 'contact', id: 'ContactForm', class: 'form-stack contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success" role="status" tabindex="-1" autofocus>{% render 'icon', icon: 'check' %} {{ 'contact.form.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form__message form__message--error form__errors" role="alert" tabindex="-1" autofocus>
          {% render 'icon', icon: 'error' %}
          <div>{{ 'contact.form.error_heading' | t }}
            <ul>{%- for field in form.errors -%}<li>{%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}<a href="#ContactForm-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>{%- endif -%}</li>{%- endfor -%}</ul>
          </div>
        </div>
      {%- endif -%}
      <div class="form-row form-row--2">
        <div class="field">
          <label class="field__label" for="ContactForm-name">{{ 'contact.form.name' | t }}</label>
          <input class="field__input" id="ContactForm-name" type="text" name="contact[{{ 'contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name">
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-email">{{ 'contact.form.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="field__input" id="ContactForm-email" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required aria-required="true"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
        </div>
      </div>
      {%- if section.settings.show_phone -%}
        <div class="field">
          <label class="field__label" for="ContactForm-phone">{{ 'contact.form.phone' | t }}</label>
          <input class="field__input" id="ContactForm-phone" type="tel" name="contact[{{ 'contact.form.phone' | t }}]" value="{{ form.phone }}" autocomplete="tel">
        </div>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ContactForm-body">{{ 'contact.form.comment' | t }} <span aria-hidden="true">*</span></label>
        <textarea class="text-area" id="ContactForm-body" name="contact[{{ 'contact.form.comment' | t }}]" required aria-required="true">{{ form.body }}</textarea>
      </div>
      <div class="contact__actions">
        <button type="submit" class="btn btn--lg">{{ 'contact.form.send' | t }} {% render 'icon', icon: 'arrow' %}</button>
        {%- if section.settings.note != blank -%}<p class="br-caption contact__note">{{ section.settings.note | escape }}</p>{%- endif -%}
      </div>
    {%- endform -%}

    {%- if section.settings.email != blank or section.settings.side_text != blank -%}
      <div class="contact__aside">
        {%- if section.settings.email != blank -%}<p class="br-caption">{{ 'contact.form.email' | t }}</p><a class="link contact__email" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>{%- endif -%}
        {%- if section.settings.side_text != blank -%}<div class="br-body rte">{{ section.settings.side_text }}</div>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "class": "paper",
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "caption", "label": "Caption", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about a project or an order? Send it here, or give us a call.</p>" },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone field", "default": false },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "We read everything and reply from a real inbox." },
    { "type": "header", "content": "Details under the form" },
    { "type": "text", "id": "email", "label": "Email address" },
    { "type": "richtext", "id": "side_text", "label": "Text" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}

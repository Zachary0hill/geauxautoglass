<section class="br-section plate--{{ section.settings.color_scheme }}" data-sc-act="flow">
  <div class="page-width">
    <div class="richtext{% if section.settings.align == 'center' %} richtext--center{% endif %}" data-sc-in data-sc-stagger="70">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}
            <p class="br-rule" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {%- when 'heading' -%}
            <h2 class="br-display richtext__heading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
          {%- when 'text' -%}
            <div class="br-body rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div class="richtext__actions" {{ block.shopify_attributes }}>
              {%- if block.settings.label != blank -%}<a class="btn{% if block.settings.style == 'ghost' %} btn--ghost{% elsif block.settings.style == 'accent' %} btn--accent{% endif %}" href="{{ block.settings.link }}">{{ block.settings.label | escape }}</a>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "class": "paper",
  "name": "Rich text",
  "tag": "div",
  "settings": [
    {
      "type": "select", "id": "align", "label": "Alignment",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ],
      "default": "left"
    },
    {
      "type": "select", "id": "color_scheme", "label": "Color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "surface", "label": "Surface" },
        { "value": "accent", "label": "Accent" },
        { "value": "pine", "label": "Pine" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    { "type": "caption", "name": "Caption", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Caption" } ] },
    { "type": "heading", "name": "Heading", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Heading", "default": "Talk about your brand" } ] },
    { "type": "text", "name": "Text", "limit": 1, "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>" } ] },
    {
      "type": "button", "name": "Button", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the wood store" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [ { "value": "solid", "label": "Solid" }, { "value": "accent", "label": "Accent" }, { "value": "ghost", "label": "Outline" } ], "default": "solid" }
      ]
    }
  ],
  "presets": [
    { "name": "Rich text", "blocks": [ { "type": "heading" }, { "type": "text" }, { "type": "button" } ] }
  ]
}
{% endschema %}
